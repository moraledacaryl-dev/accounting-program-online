[Unit]
Description=Accounting Beds24 Cancellation Reconciliation
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=oneshot
User=hiddenoasis
Group=hiddenoasis
WorkingDirectory=/opt/accounting-current/backend
EnvironmentFile=/etc/hiddenoasis/accounting-backend.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/accounting-current/backend/.venv/bin/python -m app.workers.beds24_cancellation_reconcile_worker
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
