[Unit]
Description=Accounting Operations Durable Outbox Worker
After=network.target postgresql.service accounting-backend.service
Requires=postgresql.service

[Service]
Type=simple
User=hiddenoasis
Group=hiddenoasis
WorkingDirectory=/opt/accounting-current/backend
EnvironmentFile=/etc/hiddenoasis/accounting-backend.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStartPre=/opt/accounting-current/backend/.venv/bin/alembic -c alembic.ini upgrade head
ExecStart=/opt/accounting-current/backend/.venv/bin/python -m app.workers.operations_outbox_worker
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
